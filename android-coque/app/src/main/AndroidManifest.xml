<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:usesCleartextTraffic="false"
        android:allowBackup="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Permet à la coque de reconnaître l'adresse de retour de Cap (après la connexion
                 Google faite dans Chrome) et de rouvrir la coque directement dessus.
                 autoVerify="true" : demande à Android de vérifier que la coque est bien
                 propriétaire de ce lien (fichier assetlinks.json sur le site), sinon Chrome
                 garde le retour de Google pour lui-même au lieu de rouvrir la coque. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="maxlavegie-dev.github.io"
                    android:pathPrefix="/cap/app/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
